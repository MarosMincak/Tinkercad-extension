{
  "manifest_version": 3,
  "name": "TinkerComplete — Code Completion for Tinkercad",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "description": "Arduino autocomplete, TAB snippets and compact documentation for Tinkercad Circuits. Local, fast, and AI-free.",
  "permissions": ["storage"],
  "action": {
    "default_title": "TinkerComplete",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tinkercad.com/*"],
      "js": ["settings-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tinkercad.com/*"],
      "js": ["editor.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
